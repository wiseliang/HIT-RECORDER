<view class="container">
  <!-- 完成图标 -->
  <view class="icon-wrap">
    <text class="icon">{{allSuccess ? '✅' : '⚠️'}}</text>
  </view>

  <!-- 汇总 -->
  <view class="summary-card">
    <text class="summary-title">第{{week}}周 {{typeName}}</text>
    <view class="summary-row">
      <text class="sum-label">共处理</text>
      <text class="sum-val">{{total}} 人</text>
    </view>
    <view class="summary-row">
      <text class="sum-label">用时</text>
      <text class="sum-val">{{duration}}</text>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat-item success">
      <text class="stat-num">{{progress.success}}</text>
      <text class="stat-label">成功</text>
    </view>
    <view class="stat-item skipped">
      <text class="stat-num">{{progress.skipped}}</text>
      <text class="stat-label">跳过</text>
    </view>
    <view class="stat-item error">
      <text class="stat-num">{{progress.error}}</text>
      <text class="stat-label">失败</text>
    </view>
  </view>

  <!-- 失败列表 -->
  <view class="error-list" wx:if="{{errors.length > 0}}">
    <text class="error-title">❌ 失败记录</text>
    <view class="error-item" wx:for="{{errors}}" wx:key="seq">
      <text class="error-seq">#{{item.seq}}</text>
      <text class="error-reason">{{item.reason}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-secondary" bindtap="goHome">🏠 返回首页</button>
    <button class="btn-primary" bindtap="goAgain">🔁 再次录入</button>
  </view>
</view>
