.container { padding: 24rpx; padding-bottom: 120rpx; }

.header { margin-bottom: 20rpx; }
.header-title { font-size: 36rpx; font-weight: bold; display: block; }
.header-desc { font-size: 26rpx; color: #999; margin-top: 4rpx; }

.card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-title { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }

/* 登录 */
.login-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.login-hint { font-size: 24rpx; color: #666; display: block; margin-bottom: 12rpx; }
.login-btn {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: #1B62A5; color: #fff; font-size: 30rpx; border-radius: 12rpx; border: none;
}
.code-row { display: flex; gap: 12rpx; }
.code-input {
  flex: 1; height: 80rpx; background: #F5F7FA; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 32rpx; letter-spacing: 6rpx;
}
.code-btn {
  width: 160rpx; height: 80rpx; line-height: 80rpx;
  background: #1B62A5; color: #fff; font-size: 28rpx; border-radius: 12rpx; border: none;
}

/* 周次多选 */
.week-checkbox-list { display: flex; flex-direction: column; gap: 6rpx; }
.week-check-row {
  display: flex; align-items: center; padding: 10rpx 8rpx;
  border-radius: 8rpx; background: #FAFAFA;
}
.week-check-row.active { background: #EBF3FC; }
.week-type-hint { font-size: 22rpx; color: #999; margin-left: 8rpx; }

/* 学生列表 */
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.section-head .section-title { margin-bottom: 0; }
.student-header { display: flex; justify-content: space-between; align-items: center; }
.student-header-right { display: flex; align-items: center; gap: 16rpx; }
.student-count { font-size: 24rpx; color: #999; }
.toggle-all { font-size: 24rpx; color: #1B62A5; padding: 4rpx 8rpx; }
.loading-text, .empty-text { font-size: 26rpx; color: #999; text-align: center; padding: 30rpx 0; }
.student-list { max-height: 400rpx; }
.student-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.student-name { flex: 1; font-size: 28rpx; margin-left: 12rpx; }
.student-status { font-size: 22rpx; color: #ccc; }
.load-btn {
  width: 100%; margin-top: 12rpx; height: 72rpx; line-height: 72rpx;
  background: #F5F7FA; color: #1B62A5; font-size: 26rpx; border-radius: 12rpx; border: none;
}

/* 选项 */
.option-picker { display: flex; flex-wrap: wrap; gap: 10rpx; }
.option-tag {
  padding: 10rpx 24rpx; border-radius: 8rpx; background: #F5F5F5;
  font-size: 26rpx; color: #666;
}
.option-tag.active { background: #E8A838; color: #fff; }

.content-input {
  width: 100%; height: 80rpx; background: #F5F7FA; border-radius: 12rpx;
  padding: 0 20rpx; font-size: 28rpx; box-sizing: border-box;
}

.captcha-img { width: 300rpx; display: block; margin: 12rpx auto; border-radius: 8rpx; border: 1rpx solid #eee; }

.resend-link {
  display: block; text-align: center; margin-top: 14rpx;
  font-size: 24rpx; color: #1B62A5; text-decoration: underline;
}
.resend-link.disabled { color: #ccc; text-decoration: none; }

.start-btn {
  width: 100%; height: 96rpx; line-height: 96rpx;
  background: #52C41A; color: #fff; font-size: 34rpx; font-weight: 600;
  border-radius: 48rpx; border: none; text-align: center; margin-top: 8rpx;
}
