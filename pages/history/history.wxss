.container {
  padding: 24rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.history-item:active {
  background: #F5F7FA;
}
.hi-left {
  display: flex;
  flex-direction: column;
}
.hi-week {
  font-size: 30rpx;
  font-weight: 600;
}
.hi-type {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.hi-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.hi-result {
  font-size: 28rpx;
  color: #52C41A;
  font-weight: 600;
}
.hi-date {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 4rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: #ccc;
}
