<view class="container">
  <!-- 等待验证码 -->
  <view wx:if="{{status === 'awaiting_code'}}" class="await-section">
    <text class="await-icon">🔐</text>
    <text class="await-title">需要认证APP验证码</text>
    <text class="await-hint">打开 认证APP → 我的 → 动态口令</text>
    <view class="code-row">
      <input class="code-input" placeholder="输入验证码" value="{{code}}" bindinput="onCodeInput" type="number" maxlength="6" />
      <button class="code-btn" bindtap="submitCode" loading="{{submitting}}">提交</button>
    </view>
  </view>

  <!-- 正常运行中 -->
  <block wx:else>
    <text class="status-text">
      {{status === 'completed' ? '✅ 录入完成' : status === 'failed' ? '❌ 录入失败' : '📡 执行中...'}}
    </text>

    <view class="progress-wrap">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{percent}}%"></view>
      </view>
      <text class="progress-num">{{progress.processed}} / {{total}}</text>
    </view>

    <view class="stats">
      <view class="stat-item success">
        <text class="stat-num">{{progress.success}}</text>
        <text class="stat-label">成功</text>
      </view>
      <view class="stat-item skipped">
        <text class="stat-num">{{progress.skipped}}</text>
        <text class="stat-label">跳过</text>
      </view>
      <view class="stat-item error">
        <text class="stat-num">{{progress.error}}</text>
        <text class="stat-label">失败</text>
      </view>
    </view>

    <text class="current" wx:if="{{status === 'running'}}">
      正在处理第 {{currentStudent || progress.processed}} 个...
    </text>

    <text class="hint">可关闭本页，后台继续执行</text>

    <button class="result-btn" wx:if="{{status === 'completed' || status === 'failed'}}" bindtap="goResult">
      查看详细结果 ❯
    </button>
  </block>
</view>
