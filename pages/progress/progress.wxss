.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  margin: 40rpx 0 32rpx;
}

/* 进度条 */
.progress-wrap {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.progress-bar {
  width: 100%;
  height: 20rpx;
  background: #E8E8E8;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1B62A5, #4A90D9);
  border-radius: 10rpx;
  transition: width 0.6s ease;
}
.progress-num {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

/* 统计 */
.stats {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
}
.success .stat-num { color: #52C41A; }
.skipped .stat-num { color: #FAAD14; }
.error .stat-num { color: #FF4D4F; }

.current {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 32rpx;
}

.result-btn {
  width: 80%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1B62A5;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
}

/* 等待验证码 */
.await-section {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  margin-top: 40rpx;
}
.await-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.await-title { font-size: 32rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.await-hint { font-size: 24rpx; color: #999; display: block; margin-bottom: 24rpx; }
.code-row {
  display: flex;
  gap: 12rpx;
}
.code-input {
  flex: 1;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 32rpx;
  letter-spacing: 6rpx;
}
.code-btn {
  width: 160rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #1B62A5;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

/* 重发链接 */
.resend-link {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #1B62A5;
}
.resend-link.disabled {
  color: #ccc;
}

/* 验证码图片 */
.captcha-img {
  width: 100%;
  max-width: 500rpx;
  margin: 16rpx auto;
  border-radius: 8rpx;
  border: 1px solid #eee;
}

/* 网络错误横幅 */
.error-banner {
  width: 100%;
  background: #FFF3E0;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
}
.error-banner text {
  font-size: 26rpx;
  color: #E65100;
}
