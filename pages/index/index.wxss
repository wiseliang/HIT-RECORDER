.container { padding: 24rpx; }

.week-card {
  background: linear-gradient(135deg, #1B62A5, #4A90D9);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.week-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8rpx; }
.week-num { font-size: 44rpx; font-weight: bold; }
.week-date { font-size: 24rpx; opacity: 0.85; }
.week-hint { font-size: 24rpx; opacity: 0.75; }

.entries { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 20rpx; }

.entry-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border-left: 8rpx solid #ccc;
}
.entry-card:active { background: #f5f5f5; }
.entry-card.companion { border-left-color: #4A90D9; }
.entry-card.talk { border-left-color: #E8A838; }
.entry-card.batch { border-left-color: #52C41A; }
.entry-card.fill-missing { border-left-color: #FF4D4F; }
.entry-card.grade { border-left-color: #722ED1; }
.entry-icon { font-size: 40rpx; margin-bottom: 6rpx; }
.entry-title { font-size: 32rpx; font-weight: 600; margin-bottom: 4rpx; }
.entry-desc { font-size: 24rpx; color: #999; }

.info-row {
  display: flex; align-items: center;
  background: #FFF7E6; border-radius: 12rpx; padding: 20rpx 24rpx;
}
.info-warn { font-size: 32rpx; margin-right: 12rpx; }
.info-text { flex: 1; font-size: 26rpx; color: #E8A838; }
.info-link { font-size: 26rpx; color: #1B62A5; }
