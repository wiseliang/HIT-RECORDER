.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  display: block;
}
.card-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 16rpx;
}
.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1B62A5;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  border: none;
  margin-top: 8rpx;
}
.save-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 10rpx;
}

.picker-value {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.clear-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFF2F0;
  color: #FF4D4F;
  font-size: 26rpx;
  border-radius: 36rpx;
  border: none;
}
